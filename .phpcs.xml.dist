<?xml version="1.0"?>
<ruleset name="Convoca Courses">
  <description>WordPress Coding Standards para Convoca Courses. Configuración única del repo.</description>

  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/languages/*</exclude-pattern>
  <exclude-pattern>stubs/*</exclude-pattern>
  <!--
    dev-tools/: guiones de verificación manual contra un WordPress real (siembra de datos, sondas).
    Escriben por pantalla a propósito y no viajan en el paquete (ver .distignore). El plugin en sí
    (includes/, admin/, templates/, uninstall.php) sí pasa el estándar completo.
  -->
  <exclude-pattern>dev-tools/*</exclude-pattern>
  <!--
    e2e/: arnés de la suite Playwright (fixture PHP que se ejecuta dentro de la demo). Igual que dev-tools,
    no viaja en el paquete y no es código del plugin.
  -->
  <exclude-pattern>e2e/*</exclude-pattern>
  <!--
    tests/bootstrap-integration.php: arnés de las pruebas de integración. Declara tres espacios de
    nombres (WordPress, Convoca\Core y Convoca\Gateway) y varios dobles en un solo fichero **a
    propósito**, porque tiene que definir símbolos que en producción vienen de otros plugins. Las
    pruebas de integración en sí (tests/Integration/) sí pasan el estándar completo.
  -->
  <exclude-pattern>tests/bootstrap-integration.php</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <arg name="parallel" value="8"/>

  <config name="minimum_supported_wp_version" value="6.4"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="WordPress"/>

  <!--
    Exclusiones con motivo escrito. No es un silenciador: cada una está razonada y versionada.

    Files.FileName: los ficheros de includes/ siguen PSR-4 (el nombre coincide con la clase), que es
      la convención del ecosistema Convoca y lo que exige el autoload de Composer. WPCS pediría
      minúsculas con guiones y PSR-4 dejaría de resolver en Linux (sensible a mayúsculas).
    WP.I18n (text_domain): el proyecto tiene un único dominio, fijado aquí.
  -->
  <rule ref="WordPress.Files.FileName">
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="convoca-courses"/>
      </property>
    </properties>
  </rule>

  <!--
    Capabilities propias del módulo: WPCS no las conoce y las marcaría como desconocidas en cada
    add_submenu_page()/current_user_can(). Se declaran aquí para que el aviso real siga vivo.
  -->
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="convoca_manage_courses"/>
        <element value="convoca_enroll_courses"/>
        <element value="convoca_view_certificates"/>
        <element value="convoca_grade_courses"/>
      </property>
    </properties>
  </rule>

  <!--
    Listados del catálogo del curso (selector de curso/módulo, lecciones de un curso): necesitan el
    conjunto completo, no una página de archivo. WPCS avisa por paginación alta en cada uno.
  -->
  <rule ref="WordPress.WP.PostsPerPage">
    <exclude name="WordPress.WP.PostsPerPage.posts_per_page_posts_per_page"/>
  </rule>

  <!--
    Plantillas: se incluyen para que también pasen el estándar, pero emiten HTML por diseño, así que
    las reglas de salida se aplican sobre el valor ya escapado (esc_html/esc_attr/esc_url).
  -->
  <rule ref="WordPress.Security.EscapeOutput">
    <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
  </rule>
</ruleset>
