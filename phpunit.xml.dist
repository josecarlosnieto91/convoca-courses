<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración canónica del repo: la usan la puerta local (`~/.hermes/scripts/ci-local.sh`) y el
     job de cobertura, que necesitan una suite unitaria y un filtro de cobertura en el mismo fichero.
     Es la misma suite que `phpunit-unit.xml` (que el CI sigue invocando explícitamente) con
     `defaultTestSuite="unit"` para que `phpunit` a secas no intente la integración, que necesita
     WordPress. PHPUnit 9.6: el filtro va en <coverage><include>, no en <source>. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         defaultTestSuite="unit"
         backupGlobals="false"
         colors="true"
         cacheResult="false"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnWarning="true"
         failOnRisky="true">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <coverage>
    <include>
      <directory suffix=".php">./includes</directory>
    </include>
  </coverage>
</phpunit>
