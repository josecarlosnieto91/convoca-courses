<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración canónica del repo desde el 21-10-2026: PHPUnit 10.5 (antes 9.6, el único plugin
     del ecosistema que se había quedado atrás). Aquí vive la suite unitaria y el filtro de cobertura,
     así que no hay que elegir entre "el fichero que corre el CI" y "el que mide la cobertura".
     La integración tiene su propio fichero porque necesita otro bootstrap (mock del gateway). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         defaultTestSuite="unit"
         backupGlobals="false"
         colors="true"
         cacheDirectory=".phpunit.cache"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnWarning="true"
         failOnRisky="true">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <!-- `admin/` es lógica de pantallas (no plantillas): entra. `templates/` queda fuera porque son plantillas de
       presentación con `<?php` de escape. -->
  <source>
    <include>
      <directory suffix=".php">./includes</directory>
      <directory suffix=".php">./admin</directory>
    </include>
  </source>
</phpunit>
