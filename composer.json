{
    "name": "convoca/courses",
    "description": "Cursos online para WordPress: módulos, lecciones, matrícula, progreso y certificado.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Convoca\\Courses\\": "includes/"
        },
        "classmap": [
            "admin/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.4",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpunit/phpunit": "^9.6",
        "phpstan/extension-installer": "^1.4"
    },
    "scripts": {
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G",
        "phpunit": "phpunit -c phpunit-unit.xml",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
